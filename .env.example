# Deployment settings. Copy to .env and edit:  cp .env.example .env
# .env is ignored by Git. Do not put credentials in this file.
# Values already set in your shell, and cdk -c <key>=<value>, take precedence over this file.

# AWS Region to deploy to. Choose one where Amazon Bedrock AgentCore and the model are available.
AWS_REGION=us-east-1

# Model. Leave MODEL_ID empty to pick the inference profile for AWS_REGION automatically:
#   US Regions and ca-central-1 -> us.<base>    EU Regions -> eu.<base>
#   Sydney, Melbourne, Auckland -> au.<base>    Tokyo, Osaka -> jp.<base>
#   all other commercial Regions -> global.<base>
BASE_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_ID=

# Optional: email address for completion notifications (confirm the subscription email).
NOTIFICATION_EMAIL=

# Optional: stack name. Change it to deploy a second copy in the same account and Region.
# Clients then need: remediate --stack-name <name>  (or REMEDIATION_STACK=<name>).
STACK_NAME=DependencyRemediationAgent
